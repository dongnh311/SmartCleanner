<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            x:Name="Header"
            Grid.Row="0"
            Title="Network"
            Subtitle="Active interfaces and total throughput"
            IconGlyphChar="&#xE968;" />

        <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource Card}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock x:Name="DownloadLabel" Text="Download" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                            <TextBlock x:Name="DownText" FontSize="28" FontWeight="SemiBold" Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock x:Name="UploadLabel" Text="Upload" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                            <TextBlock x:Name="UpText" FontSize="28" FontWeight="SemiBold" Text="—" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="InterfacesLabel" Text="Interfaces" FontSize="13" FontWeight="SemiBold" Opacity="0.65" />
                        <ListView x:Name="InterfacesList" SelectionMode="None" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
