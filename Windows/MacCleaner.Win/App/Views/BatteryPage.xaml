<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            x:Name="Header"
            Grid.Row="0"
            Title="Battery"
            Subtitle="Power state and remaining capacity"
            IconGlyphChar="&#xE83E;" />

        <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="PercentText" FontSize="40" FontWeight="SemiBold" Text="—" />
                    <ProgressBar x:Name="PercentBar" Minimum="0" Maximum="100" Value="0" />
                    <TextBlock x:Name="StateText"     FontSize="13" Opacity="0.75" />
                    <TextBlock x:Name="RemainingText" FontSize="12" Opacity="0.55" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
