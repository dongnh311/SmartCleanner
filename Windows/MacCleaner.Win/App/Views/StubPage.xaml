<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.StubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16"
          Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            x:Name="Header"
            Grid.Row="0" />

        <Border
            Grid.Row="1"
            Style="{StaticResource Card}"
            Margin="16,0,16,0">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    FontSize="48"
                    Glyph="&#xE7BA;"
                    Opacity="0.45" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Text="Coming soon" />
                <TextBlock
                    x:Name="StatusText"
                    HorizontalAlignment="Center"
                    Opacity="0.65"
                    TextWrapping="Wrap"
                    MaxWidth="420"
                    TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
