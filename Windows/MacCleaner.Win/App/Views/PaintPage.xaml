<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.PaintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <!-- InkCanvas requires the Microsoft.UI.Xaml InkPresenter pipeline
         which doesn't compile in our unpackaged WinAppSDK 1.6 setup
         without extra targets; the XAML compiler fails silently with
         no error message. Falling back to a placeholder for now —
         the SkiaSharp-based canvas will land separately. -->
    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            Grid.Row="0"
            Title="Paint"
            Subtitle="Canvas — InkCanvas wiring deferred"
            IconGlyphChar="&#xE7C4;" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,0">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    Text="Paint canvas pending"
                    FontSize="17"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="A SkiaSharp-backed canvas will replace the InkCanvas placeholder in a follow-up commit once a working build configuration is identified."
                    TextWrapping="Wrap"
                    MaxWidth="420"
                    TextAlignment="Center"
                    Opacity="0.65"
                    FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
