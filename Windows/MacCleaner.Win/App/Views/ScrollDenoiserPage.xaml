<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.ScrollDenoiserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            Grid.Row="0"
            Title="Scroll Denoiser"
            Subtitle="Direction-lock filter for cheap mouse wheels"
            IconGlyphChar="&#xE71C;" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,0">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    Text="Suppresses wheel events whose direction reverses within 80 ms of the previous one — the classic encoder bounce on budget mice."
                    TextWrapping="Wrap"
                    FontSize="13"
                    Opacity="0.75"
                    MaxWidth="500"
                    TextAlignment="Center" />
                <ToggleSwitch x:Name="EnableToggle" Header="Active" Toggled="EnableToggle_Toggled" />
                <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.55" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
