<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            Grid.Row="0"
            Title="Memory"
            Subtitle="Physical RAM usage, refreshed every second"
            IconGlyphChar="&#xEEA3;" />

        <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="UsedPercentText" FontSize="40" FontWeight="SemiBold" Text="—" />
                        <ProgressBar x:Name="UsedBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="UsedDetailText" FontSize="13" Opacity="0.75" />
                        <TextBlock x:Name="TotalDetailText" FontSize="12" Opacity="0.55" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
