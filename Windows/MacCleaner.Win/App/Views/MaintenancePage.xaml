<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            Grid.Row="0"
            Title="Maintenance"
            Subtitle="Run Windows upkeep in-app — admin items prompt via UAC"
            IconGlyphChar="&#xE90F;" />

        <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
            <StackPanel x:Name="Host" Spacing="12" />
        </ScrollViewer>
    </Grid>
</Page>
