<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            x:Name="Header"
            Grid.Row="0"
            Title="Settings"
            Subtitle="About this build and where it stores data"
            IconGlyphChar="&#xE713;" />

        <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
            <StackPanel Spacing="16">

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AboutLabel" Text="About" FontSize="13" FontWeight="SemiBold" Opacity="0.6" />
                        <TextBlock x:Name="ProductText" FontSize="20" FontWeight="SemiBold" Text="MacCleaner for Windows" />
                        <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.7" />
                        <TextBlock
                            x:Name="AboutDesc"
                            Text="Windows port of the macOS app — same module set, native Win32/WinRT plumbing, see WINDOWS_PORT_PLAN.md."
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="LanguageTitle" Text="Language" FontSize="13" FontWeight="SemiBold" Opacity="0.6" />
                        <ComboBox x:Name="LanguageCombo" MinWidth="180" SelectionChanged="Language_SelectionChanged">
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                        </ComboBox>
                        <TextBlock x:Name="LanguageNote" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="StartupLabel" Text="Startup" FontSize="13" FontWeight="SemiBold" Opacity="0.6" />
                        <ToggleSwitch x:Name="StartupToggle" Header="Open MacCleaner at login" Toggled="StartupToggle_Toggled" />
                        <TextBlock
                            x:Name="StartupDesc"
                            Text="Adds MacCleaner to your per-user Run list so it starts with Windows. No admin rights needed."
                            FontSize="12"
                            Opacity="0.6"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="DataLocationsLabel" Text="Data locations" FontSize="13" FontWeight="SemiBold" Opacity="0.6" />
                        <Button x:Name="OpenQuarantineButton" Content="Open Quarantine folder" Click="OpenQuarantine_Click" />
                        <Button x:Name="OpenTrendsButton" Content="Open trends database folder" Click="OpenTrends_Click" />
                        <Button x:Name="OpenMyToolsButton" Content="Show My Tools JSON" Click="OpenMyTools_Click" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
