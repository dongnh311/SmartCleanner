<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.LargeOldFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            Grid.Row="0"
            Title="Large &amp; Old"
            Subtitle="Files past the size + age thresholds"
            IconGlyphChar="&#xE787;" />

        <StackPanel Grid.Row="1" Margin="16,0,16,0" Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" PlaceholderText="Path to scan" />
                <Button x:Name="ScanButton" Grid.Column="1" Content="Scan" Style="{ThemeResource AccentButtonStyle}" Click="ScanButton_Click" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Min size (MB):" VerticalAlignment="Center" FontSize="12" />
                    <NumberBox x:Name="MinSizeMb" Value="100" Minimum="1" Maximum="100000" SmallChange="10" Width="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Min age (days):" VerticalAlignment="Center" FontSize="12" />
                    <NumberBox x:Name="MinAgeDays" Value="180" Minimum="1" Maximum="3650" SmallChange="30" Width="120" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Opacity="0.65" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,0,16,0">
            <ListView x:Name="ResultsList" SelectionMode="None" />
        </Border>
    </Grid>
</Page>
