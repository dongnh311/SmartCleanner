<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.DiskMonitorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            Grid.Row="0"
            Title="Disk Monitor"
            Subtitle="Per-physical-disk read/write throughput and queue depth"
            IconGlyphChar="&#xEDA2;" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,0">
            <ListView x:Name="DiskList" SelectionMode="None" />
        </Border>
    </Grid>
</Page>
