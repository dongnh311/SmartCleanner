<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.RecycleBinPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            x:Name="Header"
            Grid.Row="0"
            Title="Recycle Bin"
            Subtitle="Empty across all drives"
            IconGlyphChar="&#xE74D;" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,0">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="SizeText"  FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" Text="—" />
                <TextBlock x:Name="CountText" FontSize="13" Opacity="0.7" HorizontalAlignment="Center" Text="" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" />
                    <Button x:Name="EmptyButton"   Content="Empty Recycle Bin" Style="{ThemeResource AccentButtonStyle}" Click="EmptyButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.55" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
