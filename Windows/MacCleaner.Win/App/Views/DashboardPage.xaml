<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MacCleaner.Win.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MacCleaner.Win.App.Controls">

    <Grid RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:ModuleHeader
            x:Name="Header"
            Grid.Row="0"
            Title="Dashboard"
            Subtitle="CPU, memory and disk at a glance"
            IconGlyphChar="&#xE80F;" />

        <ScrollViewer Grid.Row="1" Padding="16,0,16,0">
            <StackPanel Spacing="16">

                <!-- CPU -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" Opacity="0.65" />
                        <TextBlock x:Name="CpuValueText" FontSize="32" FontWeight="SemiBold" Text="—" />
                        <ProgressBar x:Name="CpuBar" Minimum="0" Maximum="100" Value="0" />
                    </StackPanel>
                </Border>

                <!-- RAM -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Memory" FontSize="13" FontWeight="SemiBold" Opacity="0.65" />
                        <TextBlock x:Name="RamValueText" FontSize="32" FontWeight="SemiBold" Text="—" />
                        <ProgressBar x:Name="RamBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="RamSubText" FontSize="12" Opacity="0.65" />
                    </StackPanel>
                </Border>

                <!-- Drives -->
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Drives" FontSize="13" FontWeight="SemiBold" Opacity="0.65" />
                        <ItemsControl x:Name="DriveList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
