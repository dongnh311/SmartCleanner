<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Port of macOS Core/UI/DesignTokens.swift.
        Keep these values in sync across platforms so paddings and corner
        radii read identically in the macOS app and the Windows app.
    -->

    <!-- Spacing -->
    <x:Double x:Key="SpacingXxs">2</x:Double>
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingSm">8</x:Double>
    <x:Double x:Key="SpacingMd">12</x:Double>
    <x:Double x:Key="SpacingLg">16</x:Double>
    <x:Double x:Key="SpacingXl">24</x:Double>
    <x:Double x:Key="SpacingXxl">32</x:Double>

    <!-- Radius -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">14</CornerRadius>

    <!-- Pillar gradients — Smart Care dropped from Windows but the
         palette anchors Cleanup / Performance accents elsewhere. -->
    <Color x:Key="PillarCleanupStart">#6B52F5</Color>
    <Color x:Key="PillarCleanupEnd">#199EF5</Color>
    <Color x:Key="PillarProtectionStart">#30D158</Color>
    <Color x:Key="PillarProtectionEnd">#0AB67A</Color>
    <Color x:Key="PillarSpeedStart">#FF9F0A</Color>
    <Color x:Key="PillarSpeedEnd">#FF453A</Color>

    <!-- Threshold tints — used by percentTint / temperatureTint analogues -->
    <Color x:Key="TintGood">#34C759</Color>
    <Color x:Key="TintWarn">#FF9F0A</Color>
    <Color x:Key="TintBad">#FF3B30</Color>
    <SolidColorBrush x:Key="TintGoodBrush" Color="{StaticResource TintGood}" />
    <SolidColorBrush x:Key="TintWarnBrush" Color="{StaticResource TintWarn}" />
    <SolidColorBrush x:Key="TintBadBrush" Color="{StaticResource TintBad}" />

    <!-- Typography sizes mirror Font.titleLarge / titleMedium / titleSmall -->
    <x:Double x:Key="FontSizeTitleLarge">22</x:Double>
    <x:Double x:Key="FontSizeTitleMedium">17</x:Double>
    <x:Double x:Key="FontSizeTitleSmall">13</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>

</ResourceDictionary>
