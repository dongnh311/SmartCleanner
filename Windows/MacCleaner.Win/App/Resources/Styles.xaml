<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Card surface — port of macOS cardStyle(): subtle background +
        rounded corners + 0.5px hairline border. Shadow is omitted; WinUI's
        themed background already provides depth on Mica/Acrylic surfaces.
    -->
    <!-- Padding/CornerRadius hardcoded because Setter coerces from string,
         and SpacingLg/RadiusLg are typed (Double/CornerRadius) resources
         that won't auto-coerce to Thickness in a Setter value slot. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Status badge — small pill used for safety levels / severities -->
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="6,1,6,1" />
    </Style>

    <Style x:Key="StatusBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

</ResourceDictionary>
