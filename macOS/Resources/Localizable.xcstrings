    "Cache items are removed directly. Other items move to a 7-day quarantine.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục cache bị xoá thẳng. Các mục khác chuyển vào cách ly 7 ngày."
          }
        }
      }
    },
    "Caches & data for these tools will be skipped to avoid crashing the IDE or killing the emulator.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache & dữ liệu của các công cụ này sẽ được bỏ qua để tránh làm sập IDE hoặc tắt emulator."
          }
        }
      }
    },
